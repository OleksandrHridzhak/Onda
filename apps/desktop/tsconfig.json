{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "lib": ["ES2022"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "skipLibCheck": true,
        "noEmit": false,
        "baseUrl": ".",
        "paths": {
            "@onda/shared": ["../../packages/shared/index.ts"],
            "@onda/shared/*": ["../../packages/shared/*"]
        }
    },
    "include": [
        "main/**/*.ts",
        "preload/**/*.ts",
        "core/**/*.ts",
        "features/**/*.ts",
        "../../packages/shared/types/**/*.ts"
    ]
}
